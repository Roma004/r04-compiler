int32_t main(int32_t argc, uint8_t **argv) {
    int32_t i = 0;
    for (; i < argc;) {
        prints("[");
        printi(i);
        prints("] ");
        if (i == 0) {
            prints("Program name: ");
            prints(argv[i]);
            prints("\n");
        } else if (argv[i][0] == '-') {
            prints("Option: ");
            prints(argv[i]);
            prints("\n");
        } else {
            prints(argv[i]);
            prints("\n");
        }
        i += 1;
    }
    return 0;
}
