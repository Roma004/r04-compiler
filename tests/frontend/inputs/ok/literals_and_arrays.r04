void_t printi(int32_t num);
void_t prints(const int8_t *str);

int32_t main() {
    int32_t a = 255;
    int32_t b = 0xFF;
    int32_t c = 0b1010;
    int32_t d = 017;
    int8_t ch = 'A';
    const int8_t *msg = "hi";
    int32_t[3] arr;
    arr[0] = a;
    arr[1] = b;
    arr[2] = c + d;
    printi(arr[0] + arr[1] + arr[2]);
    printi(ch);
    prints(msg);
    return 0;
}
