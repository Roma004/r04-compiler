const uint32_t *g_pc;
uint32_t const *g_cp;
const uint32_t *[5]const[3] g_capp;
const uint32_t [5][10] *g_cmat;
int32_t[2][3] g_matrix;

int32_t main() {
    uint32_t x = 1;

    g_pc = &x;
    x = *g_pc;
    g_cp[0] = x;

    uint32_t v = g_capp[1][2][3];
    g_capp[1][2] = g_pc;

    v = g_cmat[3][9][4];

    uint32_t[10] row;
    row[0] = g_cmat[3][0][0];

    const uint32_t *first = (const uint32_t *) row;
    x = first[0];

    g_matrix[0][1] = (int32_t) v;

    return (int32_t) (v + row[0] + x);
}
