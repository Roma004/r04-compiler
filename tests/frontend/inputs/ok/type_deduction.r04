struct inner_t {
    int32_t a;
}

struct point_t {
    int32_t x;
    int32_t y;
    inner_t inner;
}

void_t noop(int32_t x);
int32_t id_fn();
uint64_t u64_fn();

int8_t g_i8;
int16_t g_i16;
int32_t g_i32;
int64_t g_i64;
uint8_t g_u8;
uint16_t g_u16;
uint32_t g_u32;
uint64_t g_u64;
bool_t g_flag;
const int32_t g_ci = 1;
int32_t *g_pi;
int32_t[4] g_arr;
int32_t[2][3] g_matrix;
point_t g_pt;
point_t *g_ppt;
inner_t g_inner;
const int8_t *g_str;

int32_t main() {
    int8_t i8 = 1;
    int16_t i16 = 2;
    int32_t i32 = 3;
    int64_t i64 = 4;
    uint8_t u8 = 5;
    uint16_t u16 = 6;
    uint32_t u32 = 7;
    uint64_t u64 = 8;
    bool_t flag = 0;
    int32_t *pi = &i32;
    int32_t[4] arr;
    int32_t[2][3] matrix;
    point_t pt;
    point_t *ppt = &pt;
    inner_t inner_val;
    const int8_t *str = "text";

    i32 = 2;
    u32 = 2u;
    i64 = 2l;
    u64 = 2ul;
    i32 = 0xFF;
    i32 = 0b1010;
    i32 = 017;
    i8 = 'a';
    str = "hello";

    i32 = g_i32;
    u32 = g_u32;
    i64 = g_i64;
    u64 = g_u64;
    flag = g_flag;
    i32 = g_ci;

    i32 = i8 + i8;
    u32 = u8 + u8;
    i32 = u16 + u16;
    i32 = i8 + i16;
    i64 = i32 + i64;
    i64 = u32 + i64;
    u64 = u64 + i64;
    u32 = u32 + i32;
    u64 = i32 + u64;
    i32 = 2u + (-1);
    i32 = i8 * i64;
    i32 = u8 - i32;
    u32 = i32 % u32;
    u64 = i32 & u64;
    i64 = u16 | i64;
    i32 = i8 ^ u8;

    i32 = i8 << 1;
    u32 = u32 << 1;
    i64 = i64 >> 1;
    u32 = u32 << u64;
    i32 = i8 >> i64;
    i32 = u16 << 1;

    i32 = i32 < u64;
    i32 = i32 == i32;
    i32 = i32 != u8;
    i32 = i32 <= i64;
    i32 = i32 > i32;
    i32 = i32 >= u32;
    i32 = i32 && pi;
    i32 = i32 || flag;
    i32 = !i32;
    i32 = !pi;

    i32 = -i8;
    u32 = -u32;
    i64 = -i64;
    i32 = ~i16;
    u64 = ~u64;
    i32 = -flag;
    i32 = ~u8;

    i64 = (int64_t) i32;
    pi = (int32_t *) u64;
    flag = (bool_t) i32;
    str = (const int8_t *) pi;

    i32 = arr[0];
    i32 = matrix[1][2];
    i32 = pi[2];
    i32 = g_arr[0];
    i32 = (&g_arr)[0][1];

    pi = &i32;
    pi = &arr[1];
    i32 = *pi;
    i8 = *str;
    pt = *ppt;

    pt.x = 1;
    pt.inner.a = 2;
    ppt->x = 3;
    ppt->inner.a = 4;
    i32 = pt.x + pt.inner.a + ppt->y + ppt->inner.a;
    i32 = (&pt)->x;

    noop(i32);
    i32 = id_fn();
    u64 = u64_fn();

    i32 += 1;
    pt.x += 1;
    arr[0] += 1;
    pi[0] += 1;
    u32 <<= 1;
    i8 += 1;
    u8 += 1;

    return i32;
}
