struct point_t;

struct point_t {
    int32_t x;
    int32_t y;
}

struct line_t {
    point_t a;
    point_t b;
}

void_t prints(const int8_t *str);
void_t printi(int32_t num);

int32_t main() {
    point_t p;
    point_t *pp;
    p.x = 1;
    p.y = 2;
    pp = &p;
    pp->x = 3;
    pp->y = 4;
    prints("hello\n");
    prints("world");
    printi(p.x + p.y);
    {
        int32_t z = p.x * p.y;
        printi(z);
    }
    return 0;
}
